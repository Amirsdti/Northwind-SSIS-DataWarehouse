                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">((DT_NUMERIC,18,4)#{Package\Data Flow Task\Merge Join 1.Outputs[Merge Join Output].Columns[TotalSales]} / (DT_NUMERIC,18,4)#{Package\Data Flow Task\Merge Join 1.Outputs[Merge Join Output].Columns[OrderTotalSales]}) * #{Package\Data Flow Task\Merge Join 1.Outputs[Merge Join Output].Columns[Freight]}</property>
